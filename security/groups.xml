<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="group_dashboard_admin" model="res.groups">
      <field name="name">Dashboard Admin</field>
      <field name="category_id" ref="base.module_category_hidden"/>
      <field name="comment">Full access: sees all sections, can configure visibility per group.</field>
    </record>
    <record id="group_dashboard_manager" model="res.groups">
      <field name="name">Dashboard Manager</field>
      <field name="category_id" ref="base.module_category_hidden"/>
      <field name="comment">Can see KPIs, analytics, operations and customer sections.</field>
    </record>
    <record id="group_dashboard_user" model="res.groups">
      <field name="name">Dashboard User</field>
      <field name="category_id" ref="base.module_category_hidden"/>
      <field name="comment">Basic dashboard access: KPI cards and summary tables only.</field>
    </record>
  </data>
</odoo>
