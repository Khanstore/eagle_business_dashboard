<templates xml:space="preserve">
<t t-name="advanced_business_dashboard.finance_dashboard">
<div class="eagle-app" style="height:100%;display:flex;flex-direction:column;">

  <!-- ══════════ HEADER ══════════ -->
  <div class="eagle-header">
    <div class="eagle-brand">
      <div class="eagle-brand-icon"><i class="fa fa-line-chart" style="color:#fff"/></div>
      Khan Store
    </div>
    <div class="eagle-nav">
      <button class="eagle-nav-btn" t-on-click="goToBusinessDashboard">Business</button>
      <button class="eagle-nav-btn active">Finance</button>
    </div>
    <div class="eagle-header-actions">
      <t t-if="state.autoRefresh">
        <span class="eagle-auto-badge"><span class="eagle-pulse"/>Live</span>
      </t>
      <select class="eagle-refresh-select" t-on-change="onRefreshMinsChange">
        <option value="5">5 min</option>
        <option value="10">10 min</option>
        <option value="30">30 min</option>
      </select>
      <button t-on-click="toggleAutoRefresh"
              t-attf-class="ebtn ebtn-sm #{state.autoRefresh?'ebtn-green':'ebtn-outline'}"
              style="color:inherit;">
        <i t-attf-class="fa #{state.autoRefresh?'fa-pause':'fa-refresh'}"/>
        <t t-esc="state.autoRefresh?'Stop':'Auto-refresh'"/>
      </button>
      <button class="eagle-print-btn" t-on-click="openPrintModal">
        <i class="fa fa-print"/> Print
      </button>
    </div>
  </div>

  <div class="eagle-body" style="flex:1;overflow-y:auto;padding:20px 24px 40px;">

    <!-- ══════════ PRINT MODAL ══════════ -->
    <t t-if="state.showPrintModal">
      <div class="eagle-modal-backdrop">
        <div class="eagle-modal eagle-target-modal">
          <div class="eagle-modal-header">
            <h5 class="eagle-modal-title"><i class="fa fa-print me-2"/>Print Options</h5>
            <button class="ebtn ebtn-ghost ebtn-icon" t-on-click="closePrintModal"><i class="fa fa-times"/></button>
          </div>
          <div class="eagle-modal-body"><div class="eagle-card-inner">
            <p class="text-muted small mb-3">Choose what to include in the printed PDF.</p>
            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" id="pInv" t-model="state.printInvoiceLines"/>
              <label class="form-check-label fw-semibold" for="pInv">Invoice lines
                <span class="d-block text-muted small fw-normal">Product, qty, rate per invoice</span>
              </label>
            </div>
            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" id="pVen" t-model="state.printVendorLines"/>
              <label class="form-check-label fw-semibold" for="pVen">Vendor Bill lines
                <span class="d-block text-muted small fw-normal">Product, qty, rate per bill</span>
              </label>
            </div>
            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" id="pJB" t-model="state.printJournalBalance"/>
              <label class="form-check-label fw-semibold" for="pJB">Journal Balance table
                <span class="d-block text-muted small fw-normal">Bank/cash journal summary</span>
              </label>
            </div>
            <div class="form-check form-switch mb-2">
              <input class="form-check-input" type="checkbox" id="pTx" t-model="state.printTxDetails"/>
              <label class="form-check-label fw-semibold" for="pTx">Transaction rows
                <span class="d-block text-muted small fw-normal">Full transaction list</span>
              </label>
            </div>
          </div></div>
          <div class="eagle-modal-footer">
            <button class="ebtn ebtn-outline" t-on-click="closePrintModal">Cancel</button>
            <button class="ebtn ebtn-primary" t-on-click="doPrint"><i class="fa fa-print me-1"/>Print PDF</button>
          </div>
        </div>
      </div>
    </t>

    <!-- ══════════ EXPORT PROMPT MODAL ══════════ -->
    <t t-if="state.showExportPrompt">
      <div class="eagle-modal-backdrop">
        <div class="eagle-modal eagle-target-modal">
          <div class="eagle-modal-header">
            <h5 class="eagle-modal-title"><i class="fa fa-download me-2"/>Export to CSV</h5>
            <button class="ebtn ebtn-ghost ebtn-icon" t-on-click="closeExportPrompt"><i class="fa fa-times"/></button>
          </div>
          <div class="eagle-modal-body"><div class="eagle-card-inner">
            <t t-if="state.exportPromptType === 'transactions'">
              <p class="mb-0">Export all <strong>transaction</strong> rows to CSV?</p>
            </t>
            <t t-if="state.exportPromptType !== 'transactions'">
              <p class="mb-2">Do you want to include <strong>line item details</strong> in the export?</p>
              <p class="text-muted small mb-0">
                <strong>Yes</strong> — each record is followed by its product lines (Row Type: RECORD / LINE).<br/>
                <strong>No</strong> — export summary rows only (one row per record).
              </p>
            </t>
          </div></div>
          <div class="eagle-modal-footer">
            <button class="ebtn ebtn-outline" t-on-click="closeExportPrompt">Cancel</button>
            <t t-if="state.exportPromptType === 'transactions'">
              <button class="ebtn ebtn-primary" t-on-click="()=>this.doExport(false)">
                <i class="fa fa-download me-1"/>Export
              </button>
            </t>
            <t t-if="state.exportPromptType !== 'transactions'">
              <button class="ebtn ebtn-outline" t-on-click="()=>this.doExport(false)">
                <i class="fa fa-download me-1"/>No — Summary only
              </button>
              <button class="ebtn ebtn-primary" t-on-click="()=>this.doExport(true)">
                <i class="fa fa-list me-1"/>Yes — Include lines
              </button>
            </t>
          </div>
        </div>
      </div>
    </t>

    <!-- ══════════ JOURNAL DRILL-DOWN MODAL ══════════ -->
    <t t-if="state.showDrillModal">
      <div class="eagle-modal-backdrop">
        <div class="eagle-modal">
          <div class="eagle-modal-header">
            <h5 class="eagle-modal-title">
              <i class="fa fa-list me-2"/>
              <t t-esc="state.drillTitle"/> — Transactions
              <t t-if="state.from_date"> (<t t-esc="state.from_date"/> to <t t-esc="state.to_date"/>)</t>
            </h5>
            <button class="ebtn ebtn-ghost ebtn-icon" t-on-click="closeDrillModal"><i class="fa fa-times"/></button>
          </div>
          <div class="eagle-modal-body">
            <t t-if="state.drillRows.length === 0">
              <div class="text-center text-muted py-5">
                <i class="fa fa-spinner fa-spin fa-2x mb-3 d-block"/>
                Loading transactions...
              </div>
            </t>
            <t t-if="state.drillRows.length > 0">
              <div class="eagle-table-wrap">
                <table class="eagle-table">
                  <thead><tr>
                    <th>Reference</th><th>Partner</th><th>Date</th>
                    <th class="text-end">Received</th><th class="text-end">Paid</th><th>Status</th>
                  </tr></thead>
                  <tbody>
                    <t t-foreach="state.drillRows" t-as="dr" t-key="dr.id">
                      <tr>
                        <td><a class="link" href="#" t-on-click.prevent="()=>this.openTransaction(dr.id)"><t t-esc="dr.name"/></a></td>
                        <td><t t-esc="dr.partner"/></td>
                        <td><t t-esc="dr.date"/></td>
                        <td class="text-end money-in"><t t-esc="dr.received"/></td>
                        <td class="text-end money-out"><t t-esc="dr.paid"/></td>
                        <td><span t-attf-class="ebadge #{dr.state=='posted'?'ebadge-green':'ebadge-gray'}"><t t-esc="dr.state"/></span></td>
                      </tr>
                    </t>
                  </tbody>
                  <tfoot><tr>
                    <td colspan="3">Total (<t t-esc="state.drillRows.length"/> records)</td>
                    <td class="text-end money-in fw-bold"><t t-esc="drillTotalReceived"/></td>
                    <td class="text-end money-out fw-bold"><t t-esc="drillTotalPaid"/></td>
                    <td/>
                  </tr></tfoot>
                </table>
              </div>
            </t>
          </div>
          <div class="eagle-modal-footer">
            <button class="ebtn ebtn-outline" t-on-click="closeDrillModal">Close</button>
          </div>
        </div>
      </div>
    </t>

    <!-- ══════════ KPI CARDS ══════════ -->
    <div class="eagle-kpi-grid">
      <div class="eagle-kpi-card kpi-teal clickable" t-on-click="openCashBalance" title="Click to view bank/cash journal items">
        <div class="eagle-kpi-icon"><i class="fa fa-bank"/></div>
        <div>
          <div t-attf-class="eagle-kpi-val #{currentCashPositive?'':'text-danger'}" style="font-size:1.2rem">
            <t t-esc="state.current_cash.toFixed(0)"/>
          </div>
          <div class="eagle-kpi-lbl">Cash Balance <i class="fa fa-external-link" style="font-size:10px"/></div>
          <div class="eagle-kpi-sub">BDT (this month)</div>
        </div>
      </div>
      <div class="eagle-kpi-card kpi-red clickable" t-on-click="openOverdueInvoices" title="Click to view overdue invoices">
        <div class="eagle-kpi-icon"><i class="fa fa-exclamation-triangle"/></div>
        <div>
          <div class="eagle-kpi-val"><t t-esc="state.overdue_inv_count"/></div>
          <div class="eagle-kpi-lbl">Overdue Invoices <i class="fa fa-external-link" style="font-size:10px"/></div>
          <div class="eagle-kpi-sub">BDT <t t-esc="state.overdue_inv_amount.toFixed(2)"/></div>
        </div>
      </div>
      <div class="eagle-kpi-card kpi-amber clickable" t-on-click="openOverdueBills" title="Click to view unpaid vendor bills">
        <div class="eagle-kpi-icon"><i class="fa fa-file-text"/></div>
        <div>
          <div class="eagle-kpi-val"><t t-esc="state.overdue_bills_count"/></div>
          <div class="eagle-kpi-lbl">Unpaid Bills <i class="fa fa-external-link" style="font-size:10px"/></div>
          <div class="eagle-kpi-sub">BDT <t t-esc="state.overdue_bills_amount.toFixed(2)"/></div>
        </div>
      </div>
      <div class="eagle-kpi-card kpi-purple clickable" t-on-click="openDueSoonBills" title="Click to view bills due in 7 days">
        <div class="eagle-kpi-icon"><i class="fa fa-clock-o"/></div>
        <div>
          <div class="eagle-kpi-val"><t t-esc="state.due_soon_count"/></div>
          <div class="eagle-kpi-lbl">Bills Due Soon <i class="fa fa-external-link" style="font-size:10px"/></div>
          <div class="eagle-kpi-sub">BDT <t t-esc="state.due_soon_amount.toFixed(2)"/> in 7 days</div>
        </div>
      </div>
    </div>

    <!-- ══════════ CASH FLOW SUMMARY ══════════ -->
    <div class="eagle-cashflow" style="margin-bottom:20px">
      <div class="eagle-cf-item">
        <div class="eagle-cf-icon">🏦</div>
        <div class="eagle-cf-lbl">Opening Balance</div>
        <div class="eagle-cf-val" style="color:#374151"><t t-esc="state.opening_cash.toFixed(2)"/></div>
      </div>
      <div class="eagle-cf-item">
        <div class="eagle-cf-icon">📥</div>
        <div class="eagle-cf-lbl">Month In</div>
        <div class="eagle-cf-val" style="color:#059669">+<t t-esc="state.month_in.toFixed(2)"/></div>
      </div>
      <div class="eagle-cf-item">
        <div class="eagle-cf-icon">📤</div>
        <div class="eagle-cf-lbl">Month Out</div>
        <div class="eagle-cf-val" style="color:#dc2626">-<t t-esc="state.month_out.toFixed(2)"/></div>
      </div>
      <div class="eagle-cf-item">
        <div class="eagle-cf-icon">💰</div>
        <div class="eagle-cf-lbl">Current Balance</div>
        <div t-attf-class="eagle-cf-val #{currentCashPositive?'':'text-danger'}" style="font-size:1.3rem;font-weight:900">
          <t t-esc="state.current_cash.toFixed(2)"/>
        </div>
      </div>
    </div>

    <!-- ══════════ FILTER BAR ══════════ -->
    <div class="eagle-filter">
      <div class="eagle-preset-bar">
        <button t-on-click="()=>this.applyPreset('today')"      t-attf-class="eagle-preset-btn #{state.active_preset=='today'?'active':''}">Today</button>
        <button t-on-click="()=>this.applyPreset('this_week')"  t-attf-class="eagle-preset-btn #{state.active_preset=='this_week'?'active':''}">This Week</button>
        <button t-on-click="()=>this.applyPreset('this_month')" t-attf-class="eagle-preset-btn #{state.active_preset=='this_month'?'active':''}">This Month</button>
        <button t-on-click="()=>this.applyPreset('this_year')"  t-attf-class="eagle-preset-btn #{state.active_preset=='this_year'?'active':''}">This Year</button>
        <button t-on-click="()=>this.applyPreset('all')"        t-attf-class="eagle-preset-btn #{state.active_preset=='all'?'active':''}">All Time</button>
      </div>
      <div class="row g-2 align-items-end">
        <div class="col-6 col-md-auto">
          <label class="form-label mb-1 small text-muted">Month</label>
          <select class="form-select form-select-sm" t-on-change="onMonthChange">
            <t t-foreach="monthOptions" t-as="mo" t-key="mo.value">
              <option t-att-value="mo.value" t-att-selected="state.selected_month==mo.value"><t t-esc="mo.label"/></option>
            </t>
          </select>
        </div>
        <div class="col-6 col-md-auto">
          <label class="form-label mb-1 small text-muted">Year</label>
          <select class="form-select form-select-sm" t-on-change="onYearChange">
            <t t-foreach="yearOptions" t-as="yr" t-key="yr">
              <option t-att-value="yr" t-att-selected="state.selected_year==yr.toString()"><t t-esc="yr"/></option>
            </t>
          </select>
        </div>
        <div class="col-6 col-md-auto">
          <label class="form-label mb-1 small text-muted">From</label>
          <input type="date" class="form-control form-control-sm" t-model="state.from_date" t-on-change="onDateChange"/>
        </div>
        <div class="col-6 col-md-auto">
          <label class="form-label mb-1 small text-muted">To</label>
          <input type="date" class="form-control form-control-sm" t-model="state.to_date" t-on-change="onDateChange"/>
        </div>
        <div class="col-12 col-md">
          <label class="form-label mb-1 small text-muted">Partner Name</label>
          <input type="text" class="form-control form-control-sm" placeholder="Search by name..." t-model="state.partner_filter"/>
        </div>
        <div class="col-12 col-md-auto">
          <label class="form-label mb-1 small text-muted">Partner ID</label>
          <div class="input-group input-group-sm">
            <select class="form-select form-select-sm" style="min-width:150px"
                    t-on-change="(ev)=>{this.state.partner_id_filter=ev.target.value;}">
              <option value="">— All Partners —</option>
              <t t-foreach="state.partnerOptions" t-as="p" t-key="p.id">
                <option t-att-value="p.id" t-att-selected="state.partner_id_filter===p.id">
                  <t t-esc="p.name"/> (#<t t-esc="p.id"/>)
                </option>
              </t>
            </select>
            <t t-if="state.partner_id_filter">
              <button class="btn btn-outline-secondary btn-sm" t-on-click="()=>{this.state.partner_id_filter='';}">&#x2715;</button>
            </t>
          </div>
        </div>
      </div>
    </div>

    <!-- ══════════ JOURNAL BALANCE ══════════ -->
    <div class="eagle-card">
      <div class="eagle-card-header">
        <h4 class="eagle-card-title"><i class="fa fa-balance-scale"/>Journal Balance <span class="ebadge ebadge-blue ms-1"><t t-esc="state.journal_balances.length"/></span></h4>
        <div class="d-flex gap-2">
          <span class="text-muted small align-self-center"><i class="fa fa-hand-o-up me-1"/>Click row to drill down</span>
          <button class="ebtn ebtn-sm ebtn-outline" t-on-click="exportJB" title="Export CSV"><i class="fa fa-download"/></button>
        </div>
      </div>
      <div class="eagle-table-wrap">
        <table class="eagle-table">
          <thead><tr>
            <th>Journal Name</th>
            <th class="text-end">Previous Balance</th>
            <th class="text-end">Deposit</th>
            <th class="text-end">Withdraw</th>
            <th class="text-end">Change</th>
            <th class="text-end">New Balance</th>
          </tr></thead>
          <tbody>
            <t t-if="state.journal_balances.length===0">
              <tr><td colspan="6" class="text-center text-muted py-4 fst-italic">No bank/cash journals found.</td></tr>
            </t>
            <t t-foreach="state.journal_balances" t-as="jb" t-key="jb.journal_name">
              <tr class="jb-row-clickable" t-on-click="()=>this.openDrillDown(jb)">
                <td class="fw-semibold"><i class="fa fa-chevron-right me-1" style="font-size:10px;color:#9ca3af"/><t t-esc="jb.journal_name"/></td>
                <td class="text-end money"><t t-esc="jb.opening.toFixed(2)"/></td>
                <td class="text-end money-in">
                  <t t-esc="jb.deposit.toFixed(2)"/>
                  <span class="text-muted ms-1" style="font-size:10px">(<t t-esc="jb.deposit_count"/>)</span>
                </td>
                <td class="text-end money-out">
                  <t t-esc="jb.withdraw.toFixed(2)"/>
                  <span class="text-muted ms-1" style="font-size:10px">(<t t-esc="jb.withdraw_count"/>)</span>
                </td>
                <td t-attf-class="text-end fw-bold #{jb.change>=0?'money-in':'money-out'}">
                  <t t-if="jb.change>=0">+</t><t t-esc="jb.change.toFixed(2)"/>
                </td>
                <td t-attf-class="text-end fw-bold #{jb.closing>=0?'':'money-out'}" style="color:#1d4ed8">
                  <t t-esc="jb.closing.toFixed(2)"/>
                </td>
              </tr>
            </t>
          </tbody>
          <tfoot><tr>
            <td>Total (<t t-esc="state.journal_balances.length"/> journals)</td>
            <td class="text-end money"><t t-esc="jbTotalOpening"/></td>
            <td class="text-end money-in"><t t-esc="jbTotalDeposit"/> <span class="text-muted ms-1" style="font-size:10px">(<t t-esc="jbTotalDepositCount"/>)</span></td>
            <td class="text-end money-out"><t t-esc="jbTotalWithdraw"/> <span class="text-muted ms-1" style="font-size:10px">(<t t-esc="jbTotalWithdrawCount"/>)</span></td>
            <td t-attf-class="text-end fw-bold #{jbTotalChangePositive?'money-in':'money-out'}">
              <t t-if="jbTotalChangePositive">+</t><t t-esc="jbTotalChange"/>
            </td>
            <td class="text-end fw-bold" style="color:#1d4ed8"><t t-esc="jbTotalClosing"/></td>
          </tr></tfoot>
        </table>
      </div>
    </div>

    <!-- ══════════ INVOICES + VENDOR BILLS ══════════ -->
    <div class="eagle-two-col">
      <!-- Invoices -->
      <div class="eagle-card">
        <div class="eagle-card-header">
          <h4 class="eagle-card-title"><i class="fa fa-file-text-o"/>Invoices <span class="ebadge ebadge-blue ms-1"><t t-esc="filteredInvoices.length"/></span></h4>
          <button class="ebtn ebtn-sm ebtn-outline" t-on-click="exportInvoices" title="Export CSV"><i class="fa fa-download"/></button>
        </div>
        <div class="eagle-table-wrap">
          <table class="eagle-table">
            <thead><tr>
              <th>Invoice</th><th>Partner</th>
              <th t-if="showDateColumn">Date</th>
              <th>Due</th><th class="text-end">Amount</th><th class="text-end">Outstanding</th><th>Status</th>
            </tr></thead>
            <tbody>
              <t t-foreach="filteredInvoices" t-as="inv" t-key="inv.id">
                <tr>
                  <td><a class="link" href="#" t-on-click.prevent="()=>this.openInvoice(inv.id)"><t t-esc="inv.name"/></a></td>
                  <td><a class="link" href="#" t-on-click.prevent="()=>this.openPartner(inv.partner_id)"><t t-esc="inv.partner"/></a></td>
                  <td t-if="showDateColumn"><t t-esc="inv.date"/></td>
                  <td><t t-esc="inv.due_date"/></td>
                  <td class="text-end money"><t t-esc="inv.amount"/></td>
                  <td class="text-end money-out"><t t-esc="inv.residual"/></td>
                  <td>
                    <span t-attf-class="ebadge #{inv.state=='paid'?'ebadge-green':inv.state=='partial'?'ebadge-yellow':'ebadge-red'}">
                      <t t-esc="inv.state"/>
                    </span>
                  </td>
                </tr>
              </t>
            </tbody>
            <tfoot><tr>
              <td t-att-colspan="showDateColumn?4:3">Total (<t t-esc="filteredInvoices.length"/>)</td>
              <td class="text-end money fw-bold"><t t-esc="invoiceTotalAmount"/></td>
              <td class="text-end money-out fw-bold"><t t-esc="invoiceTotalResidual"/></td>
              <td/>
            </tr></tfoot>
          </table>
        </div>
      </div>

      <!-- Vendor Bills -->
      <div class="eagle-card">
        <div class="eagle-card-header">
          <h4 class="eagle-card-title"><i class="fa fa-file-o"/>Vendor Bills <span class="ebadge ebadge-amber ms-1" style="background:#fef3c7;color:#92400e"><t t-esc="filteredVendorBills.length"/></span></h4>
          <button class="ebtn ebtn-sm ebtn-outline" t-on-click="exportVendors" title="Export CSV"><i class="fa fa-download"/></button>
        </div>
        <div class="eagle-table-wrap">
          <table class="eagle-table">
            <thead><tr>
              <th>Bill</th><th>Partner</th>
              <th t-if="showDateColumn">Date</th>
              <th>Due</th><th class="text-end">Amount</th><th class="text-end">Outstanding</th><th>Status</th>
            </tr></thead>
            <tbody>
              <t t-foreach="filteredVendorBills" t-as="vb" t-key="vb.id">
                <tr>
                  <td><a class="link" href="#" t-on-click.prevent="()=>this.openInvoice(vb.id)"><t t-esc="vb.name"/></a></td>
                  <td><a class="link" href="#" t-on-click.prevent="()=>this.openPartner(vb.partner_id)"><t t-esc="vb.partner"/></a></td>
                  <td t-if="showDateColumn"><t t-esc="vb.date"/></td>
                  <td><t t-esc="vb.due_date"/></td>
                  <td class="text-end money"><t t-esc="vb.amount"/></td>
                  <td class="text-end money-out"><t t-esc="vb.residual"/></td>
                  <td>
                    <span t-attf-class="ebadge #{vb.state=='paid'?'ebadge-green':vb.state=='partial'?'ebadge-yellow':'ebadge-red'}">
                      <t t-esc="vb.state"/>
                    </span>
                  </td>
                </tr>
              </t>
            </tbody>
            <tfoot><tr>
              <td t-att-colspan="showDateColumn?4:3">Total (<t t-esc="filteredVendorBills.length"/>)</td>
              <td class="text-end money fw-bold"><t t-esc="vendorTotalAmount"/></td>
              <td class="text-end money-out fw-bold"><t t-esc="vendorTotalResidual"/></td>
              <td/>
            </tr></tfoot>
          </table>
        </div>
      </div>
    </div>

    <!-- ══════════ TRANSACTIONS ══════════ -->
    <div class="eagle-card">
      <div class="eagle-card-header">
        <h4 class="eagle-card-title"><i class="fa fa-exchange"/>Transactions <span class="ebadge ebadge-blue ms-1"><t t-esc="filteredTransactions.length"/></span></h4>
        <div class="d-flex gap-2 flex-wrap">
          <button class="ebtn ebtn-sm ebtn-outline" t-on-click="exportTx" title="Export CSV"><i class="fa fa-download"/></button>
          <button class="ebtn ebtn-sm ebtn-blue" t-on-click="()=>this.createPayment('inbound')">
            <i class="fa fa-arrow-down"/> Receive
          </button>
          <button class="ebtn ebtn-sm ebtn-red" t-on-click="()=>this.createPayment('outbound')">
            <i class="fa fa-arrow-up"/> Payment
          </button>
        </div>
      </div>
      <div class="eagle-table-wrap">
        <table class="eagle-table">
          <thead><tr>
            <th class="sortable" t-on-click="()=>this.sortTransactions('name')">Reference <i t-attf-class="fa #{state.sortKey=='name'?(state.sortOrder=='asc'?'fa-sort-asc':'fa-sort-desc'):'fa-sort'}"/></th>
            <th t-if="showDateColumn" class="sortable" t-on-click="()=>this.sortTransactions('date')">Date <i t-attf-class="fa #{state.sortKey=='date'?(state.sortOrder=='asc'?'fa-sort-asc':'fa-sort-desc'):'fa-sort'}"/></th>
            <th class="sortable" t-on-click="()=>this.sortTransactions('partner')">Partner <i t-attf-class="fa #{state.sortKey=='partner'?(state.sortOrder=='asc'?'fa-sort-asc':'fa-sort-desc'):'fa-sort'}"/></th>
            <th class="sortable" t-on-click="()=>this.sortTransactions('journal')">Journal <i t-attf-class="fa #{state.sortKey=='journal'?(state.sortOrder=='asc'?'fa-sort-asc':'fa-sort-desc'):'fa-sort'}"/></th>
            <th class="sortable text-end" t-on-click="()=>this.sortTransactions('received')">Received <i t-attf-class="fa #{state.sortKey=='received'?(state.sortOrder=='asc'?'fa-sort-asc':'fa-sort-desc'):'fa-sort'}"/></th>
            <th class="sortable text-end" t-on-click="()=>this.sortTransactions('paid')">Paid <i t-attf-class="fa #{state.sortKey=='paid'?(state.sortOrder=='asc'?'fa-sort-asc':'fa-sort-desc'):'fa-sort'}"/></th>
            <th>Status</th>
          </tr></thead>
          <tbody>
            <t t-foreach="groupedTransactions" t-as="tx" t-key="tx.id||tx._journal">
              <t t-if="tx._type==='subtotal'">
                <tr class="table-secondary fw-semibold fst-italic" style="border-top:2px solid #d1d5db">
                  <td/><t t-if="showDateColumn"><td/></t>
                  <td/><td class="small text-muted"><t t-esc="tx._journal"/> — total <span class="ebadge ebadge-gray ms-1"><t t-esc="tx._count"/></span></td>
                  <td class="text-end money-in"><t t-esc="tx._received"/></td>
                  <td class="text-end money-out"><t t-esc="tx._paid"/></td>
                  <td/>
                </tr>
              </t>
              <t t-if="tx._type==='data'">
                <tr>
                  <td><a class="link" href="#" t-on-click.prevent="()=>this.openTransaction(tx.id)"><t t-esc="tx.name"/></a></td>
                  <td t-if="showDateColumn"><t t-esc="tx.date"/></td>
                  <td><a class="link" href="#" t-on-click.prevent="()=>this.openPartner(tx.partner_id)"><t t-esc="tx.partner"/></a></td>
                  <td><t t-esc="tx.journal"/></td>
                  <td class="text-end money-in"><t t-esc="tx.received"/></td>
                  <td class="text-end money-out"><t t-esc="tx.paid"/></td>
                  <td><span t-attf-class="ebadge #{tx.state=='posted'?'ebadge-green':tx.state=='draft'?'ebadge-gray':'ebadge-yellow'}"><t t-esc="tx.state"/></span></td>
                </tr>
              </t>
            </t>
          </tbody>
          <tfoot><tr>
            <td t-att-colspan="showDateColumn?4:3">Total (<t t-esc="filteredTransactions.length"/> records)</td>
            <td class="text-end money-in fw-bold"><t t-esc="txTotalReceived"/></td>
            <td class="text-end money-out fw-bold"><t t-esc="txTotalPaid"/></td>
            <td/>
          </tr></tfoot>
        </table>
      </div>
    </div>

  </div><!-- eagle-body -->
</div><!-- eagle-app -->
</t>
</templates>
