<templates xml:space="preserve">
<t t-name="advanced_business_dashboard.dashboard">
<div class="container-fluid" style="max-height: 90vh; overflow-y: auto;">
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
    <h2 class="mb-0">Dashboard</h2>
    <button class="btn btn-sm btn-outline-dark" t-on-click="openPrintModal">
        <i class="fa fa-print me-1"/> Print
    </button>
</div>

    <!-- ── Print Modal ── -->
    <t t-if="state.showPrintModal">
      <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered" style="max-width:380px; width:90vw;">
          <div class="modal-content">
            <div class="modal-header py-2">
              <h5 class="modal-title">Print Options</h5>
              <button type="button" class="btn-close" t-on-click="closePrintModal"/>
            </div>
            <div class="modal-body">
              <p class="mb-3 text-muted small">Choose what to include in the printed PDF.</p>
              <p class="small fw-semibold mb-2">What to include in the PDF:</p>

              <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="printOrderLines"
                       t-model="state.printOrderLines"/>
                <label class="form-check-label" for="printOrderLines">
                  <strong>Order lines</strong>
                  <span class="d-block text-muted small">Show product, qty, rate under each order/quotation</span>
                </label>
              </div>

              <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="printPurchaseLines"
                       t-model="state.printPurchaseLines"/>
                <label class="form-check-label" for="printPurchaseLines">
                  <strong>Purchase lines</strong>
                  <span class="d-block text-muted small">Show product, qty, rate under each purchase/RFQ</span>
                </label>
              </div>

              <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" id="printTxDetails"
                       t-model="state.printTxDetails"/>
                <label class="form-check-label" for="printTxDetails">
                  <strong>Transaction detail rows</strong>
                  <span class="d-block text-muted small">Show the full transaction list</span>
                </label>
              </div>
            </div>
            <div class="modal-footer py-2">
              <button class="btn btn-secondary btn-sm" t-on-click="closePrintModal">Cancel</button>
              <button class="btn btn-dark btn-sm" t-on-click="doPrint">
                <i class="fa fa-print me-1"/> Print PDF
              </button>
            </div>
          </div>
        </div>
      </div>
    </t>

    <!-- ── Filter Bar ── -->
    <div class="card mb-3 p-3 bg-light">

        <!-- Row 1: Preset buttons -->
        <div class="mb-2 d-flex flex-wrap gap-2">
            <button t-on-click="() => this.applyPreset('today')"
                    t-attf-class="btn btn-sm #{state.active_preset == 'today' ? 'btn-primary' : 'btn-outline-secondary'}">
                Today
            </button>
            <button t-on-click="() => this.applyPreset('this_week')"
                    t-attf-class="btn btn-sm #{state.active_preset == 'this_week' ? 'btn-primary' : 'btn-outline-secondary'}">
                This Week
            </button>
            <button t-on-click="() => this.applyPreset('this_month')"
                    t-attf-class="btn btn-sm #{state.active_preset == 'this_month' ? 'btn-primary' : 'btn-outline-secondary'}">
                This Month
            </button>
            <button t-on-click="() => this.applyPreset('this_year')"
                    t-attf-class="btn btn-sm #{state.active_preset == 'this_year' ? 'btn-primary' : 'btn-outline-secondary'}">
                This Year
            </button>
            <button t-on-click="() => this.applyPreset('all')"
                    t-attf-class="btn btn-sm #{state.active_preset == 'all' ? 'btn-primary' : 'btn-outline-secondary'}">
                All Time
            </button>
        </div>

        <!-- Row 2: Month picker | Year picker | Custom range | Partner -->
        <div class="row g-2 align-items-end">

            <div class="col-6 col-md-auto">
                <label class="form-label mb-1 small text-muted">Month</label>
                <select class="form-select form-select-sm" t-on-change="onMonthChange">
                    <t t-foreach="monthOptions" t-as="mo" t-key="mo.value">
                        <option t-att-value="mo.value"
                                t-att-selected="state.selected_month == mo.value">
                            <t t-esc="mo.label"/>
                        </option>
                    </t>
                </select>
            </div>

            <div class="col-6 col-md-auto">
                <label class="form-label mb-1 small text-muted">Year</label>
                <select class="form-select form-select-sm" t-on-change="onYearChange">
                    <t t-foreach="yearOptions" t-as="yr" t-key="yr">
                        <option t-att-value="yr"
                                t-att-selected="state.selected_year == yr.toString()">
                            <t t-esc="yr"/>
                        </option>
                    </t>
                </select>
            </div>

            <div class="col-6 col-md-auto">
                <label class="form-label mb-1 small text-muted">From</label>
                <input type="date" class="form-control form-control-sm"
                       t-model="state.from_date"
                       t-on-change="onDateChange"/>
            </div>

            <div class="col-6 col-md-auto">
                <label class="form-label mb-1 small text-muted">To</label>
                <input type="date" class="form-control form-control-sm"
                       t-model="state.to_date"
                       t-on-change="onDateChange"/>
            </div>

            <div class="col-12 col-md">
                <label class="form-label mb-1 small text-muted">Partner</label>
                <input type="text" class="form-control form-control-sm"
                       placeholder="Search partner..."
                       t-model="state.partner_filter"/>
            </div>

        </div>
    </div>

    <div class="row g-3">
<div class="col-12 col-md-6">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
    <h3 class="mb-0">Orders</h3>
    <button class="btn btn-sm btn-primary" t-on-click="createOrder">
      <i class="fa fa-plus me-1"/> New Order
    </button>
  </div>
  <div class="table-responsive">
  <table class="table table-bordered table-sm">
    <thead class="table-light">
      <tr>
        <th>Order</th>
        <th>Partner</th>
        <th t-if="showDateColumn">Date</th>
        <th>Status</th>
        <th>Invoice Status</th>
        <th>Amount</th>
      </tr>
    </thead>
    <tbody>
      <t t-foreach="filteredOrders" t-as="o" t-key="o.id">
        <tr>
          <td>
            <a href="#" t-on-click.prevent="() => this.openOrder(o.id)">
              <t t-esc="o.name"/>
            </a>
          </td>
          <td>
            <a href="#" t-on-click.prevent="() => this.openPartner(o.partner_id)">
              <t t-esc="o.partner"/>
            </a>
          </td>
          <td t-if="showDateColumn"><t t-esc="o.date"/></td>
          <td><t t-esc="o.status"/></td>
          <td>
            <span t-attf-class="badge #{o.invoice_status == 'invoiced' ? 'bg-success' : o.invoice_status == 'to invoice' ? 'bg-warning text-dark' : o.invoice_status == 'upselling' ? 'bg-info' : 'bg-secondary'}">
              <t t-esc="o.invoice_status"/>
            </span>
          </td>
          <td><t t-esc="o.amount"/></td>
        </tr>
      </t>
    </tbody>
  </table>
  </div>
</div>

        <div class="col-12 col-md-6">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
    <h3 class="mb-0">Purchase</h3>
    <button class="btn btn-sm btn-success" t-on-click="createPurchase">
      <i class="fa fa-plus me-1"/> New Purchase
    </button>
  </div>
  <div class="table-responsive">
  <table class="table table-bordered table-sm">
    <thead class="table-light">
      <tr>
        <th>Order</th>
        <th>Partner</th>
        <th t-if="showDateColumn">Date</th>
        <th>Status</th>
        <th>Billing Status</th>
        <th>Amount</th>
      </tr>
    </thead>
    <tbody>
      <t t-foreach="filteredPurchases" t-as="p" t-key="p.id">
        <tr>
          <td>
            <a href="#" t-on-click.prevent="() => this.openPurchase(p.id)">
              <t t-esc="p.name"/>
            </a>
          </td>
          <td>
            <a href="#" t-on-click.prevent="() => this.openPartner(p.partner_id)">
              <t t-esc="p.partner"/>
            </a>
          </td>
          <td t-if="showDateColumn"><t t-esc="p.date"/></td>
          <td><t t-esc="p.status"/></td>
          <td>
            <span t-attf-class="badge #{p.billing_status == 'invoiced' ? 'bg-success' : p.billing_status == 'to invoice' ? 'bg-warning text-dark' : 'bg-secondary'}">
              <t t-esc="p.billing_status"/>
            </span>
          </td>
          <td><t t-esc="p.amount"/></td>
        </tr>
      </t>
    </tbody>
  </table>
  </div>
</div>
</div>

    <div class="row g-3 mt-1">
<div class="col-12 col-md-6">
<h3>Quotations</h3>
  <div class="table-responsive">
    <table class="table table-bordered table-sm">
<tr>
    <th>Quotation</th>
    <th>Partner</th>
    <th t-if="showDateColumn">Date</th>
    <th>Status</th>
    <th>Amount</th></tr>
        <t t-foreach="filteredQuotations" t-as="q" t-key="q.id">
<tr>
<td>
    <a href="#"
       t-on-click.prevent="() => this.openOrder(q.id)">
        <t t-esc="q.name"/>
    </a>
</td>
    <td><a href="#"
       t-on-click.prevent="() => this.openPartner(q.partner_id)">
        <t t-esc="q.partner"/>
    </a></td>
    <td t-if="showDateColumn"><t t-esc="q.date"/></td>
    <td><t t-esc="q.status"/></td>
    <td><t t-esc="q.amount"/></td>
</tr>
</t>
</table>
  </div>
</div>

        <div class="col-12 col-md-6">
<h3>RFQ</h3>
  <div class="table-responsive">
            <table class="table table-bordered table-sm">
<tr><th>Order</th>
    <th>Partner</th>
    <th t-if="showDateColumn">Date</th>
    <th>Status</th>
    <th>Amount</th></tr>
                <t t-foreach="filteredRfq" t-as="p" t-key="p.id">
<tr>
<td>
    <a href="#"
       t-on-click.prevent="() => this.openPurchase(p.id)">
        <t t-esc="p.name"/>
    </a>
</td>
    <td><a href="#"
       t-on-click.prevent="() => this.openPartner(p.partner_id)">
        <t t-esc="p.partner"/>
    </a></td>
    <td t-if="showDateColumn"><t t-esc="p.date"/></td>
    <td><t t-esc="p.status"/></td>
    <td><t t-esc="p.amount"/></td>
</tr>
</t>
</table>
  </div>
</div>
</div>

    <!-- ── Transactions ── -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3 mb-1">
      <h3 class="mb-0">Transactions</h3>
      <div class="d-flex gap-2">
        <button class="btn btn-sm text-white" style="background-color:#0d6efd;"
                t-on-click="() => this.createPayment('inbound')">
          <i class="fa fa-arrow-down me-1"/> New Receive
        </button>
        <button class="btn btn-sm text-white" style="background-color:#dc3545;"
                t-on-click="() => this.createPayment('outbound')">
          <i class="fa fa-arrow-up me-1"/> New Payment
        </button>
      </div>
    </div>
    <div class="table-responsive">
<table class="table table-bordered table-sm">
    <thead>
        <tr>
            <th t-on-click="() => this.sortTransactions('name')" style="cursor: pointer;">
                Name <i t-attf-class="fa #{state.sortKey == 'name' ? (state.sortOrder == 'asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'}"/>
            </th>
            <th t-if="showDateColumn" t-on-click="() => this.sortTransactions('date')" style="cursor: pointer;">
                Date <i t-attf-class="fa #{state.sortKey == 'date' ? (state.sortOrder == 'asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'}"/>
            </th>
            <th t-on-click="() => this.sortTransactions('partner')" style="cursor: pointer;">
                Partner <i t-attf-class="fa #{state.sortKey == 'partner' ? (state.sortOrder == 'asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'}"/>
            </th>
            <th t-on-click="() => this.sortTransactions('ledger')" style="cursor: pointer;">
                Ledger <i t-attf-class="fa #{state.sortKey == 'ledger' ? (state.sortOrder == 'asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'}"/>
            </th>
            <th t-on-click="() => this.sortTransactions('received')" style="cursor: pointer;">
                Received <i t-attf-class="fa #{state.sortKey == 'received' ? (state.sortOrder == 'asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'}"/>
            </th>
            <th t-on-click="() => this.sortTransactions('paid')" style="cursor: pointer;">
                Paid <i t-attf-class="fa #{state.sortKey == 'paid' ? (state.sortOrder == 'asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'}"/>
            </th>
            <th t-on-click="() => this.sortTransactions('state')" style="cursor: pointer;">
                Status <i t-attf-class="fa #{state.sortKey == 'state' ? (state.sortOrder == 'asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'}"/>
            </th>
        </tr>
    </thead>
    <tbody>
        <t t-foreach="filteredTransactions" t-as="t" t-key="t.id">
            <tr>
                <td>
                    <a href="#" t-on-click.prevent="() => this.openTransaction(t.id)">
                        <t t-esc="t.name"/>
                    </a>
                </td>
                <td t-if="showDateColumn"><t t-esc="t.date"/></td>
                <td><a href="#"
                   t-on-click.prevent="() => this.openPartner(t.partner_id)">
                    <t t-esc="t.partner"/>
                </a></td>
                <td><t t-esc="t.ledger"/></td>
                <td class="font-monospace" style="color:#0d6efd;"><t t-esc="t.received"/></td>
                <td class="font-monospace" style="color:#dc3545;"><t t-esc="t.paid"/></td>
                <td><t t-esc="t.state"/></td>
            </tr>
        </t>
    </tbody>
    <tfoot class="table-secondary fw-bold">
        <tr>
            <td t-att-colspan="showDateColumn ? 4 : 3">Total (<t t-esc="filteredTransactions.length"/> records)</td>
            <td class="font-monospace" style="color:#0d6efd;"><t t-esc="txTotalReceived"/></td>
            <td class="font-monospace" style="color:#dc3545;"><t t-esc="txTotalPaid"/></td>
            <td/>
        </tr>
    </tfoot>
</table>
    </div>
</div>
</t>
</templates>
