<templates xml:space="preserve">
<t t-name="advanced_business_dashboard.operations_dashboard">
<div t-attf-class="eagle-app #{state.darkMode ? 'dark' : ''}" t-att-style="themeStyle + 'height:100%;display:flex;flex-direction:column;'">

  <!-- HEADER -->
  <div class="eagle-header">
    <div class="eagle-brand">
      <div class="eagle-brand-icon" style="overflow:hidden;">
        <img t-if="state.companyId" t-attf-src="/web/image/res.company/#{state.companyId}/logo" alt="" style="width:100%;height:100%;object-fit:contain;"/>
        <i t-if="!state.companyId" class="fa fa-cubes" style="color:#fff"/>
      </div>
      <t t-esc="state.companyName || 'Operations Dashboard'"/>
    </div>
    <div class="eagle-search-wrap">
      <i class="fa fa-search eagle-search-icon"/>
      <input class="eagle-search-input" type="text" placeholder="Search orders, partners..." t-model="state.partner_filter"/>
    </div>
    <div class="eagle-header-actions">
      <t t-if="state.onlineUsers.length > 0">
        <div class="eagle-presence-strip" t-att-title="state.onlineUsers.map(u=>u.name).join(', ')">
          <t t-foreach="state.onlineUsers.slice(0,4)" t-as="u" t-key="u.id">
            <div class="eagle-presence-avatar"><t t-esc="u.name.charAt(0).toUpperCase()"/></div>
          </t>
        </div>
      </t>
      <button class="eagle-darkmode-btn" t-on-click="toggleDarkMode" title="Toggle dark mode">
        <i t-attf-class="fa #{state.darkMode?'fa-sun-o':'fa-moon-o'}"/>
      </button>
      <button class="ebtn ebtn-sm ebtn-outline" t-on-click="()=>this.goToBusinessDashboard()" title="Business Dashboard"><i class="fa fa-th-large"/></button>
      <button class="ebtn ebtn-sm ebtn-outline" t-on-click="()=>this.goToFinanceDashboard()" title="Finance Dashboard"><i class="fa fa-line-chart"/></button>
      <button class="ebtn ebtn-sm ebtn-outline" t-on-click="()=>this.state.showCommandPalette=true" title="Command palette"><i class="fa fa-sliders"/></button>
      <span class="eagle-refresh-status"><i class="fa fa-clock-o"/> Updated <t t-esc="state.lastUpdated || '—'"/></span>
    </div>
  </div>

  <div class="eagle-body" style="flex:1;overflow-y:auto;padding:18px 20px 36px;">

    <!-- COMMAND PALETTE -->
    <t t-if="state.showCommandPalette">
      <div class="eagle-cmdk-backdrop" t-on-click="closeCommandPalette">
        <div class="eagle-cmdk-box" t-on-click.stop="">
          <input class="eagle-cmdk-input" type="text" placeholder="Type a command..." autofocus="autofocus" t-model="state.commandQuery" t-on-input="onCommandQueryChange"/>
          <div class="eagle-cmdk-list">
            <t t-foreach="commandActions" t-as="a" t-key="a.label">
              <div class="eagle-cmdk-item" t-on-click="()=>this.runCommand(a)"><i t-attf-class="fa #{a.icon}"/> <t t-esc="a.label"/></div>
            </t>
          </div>
          <div class="eagle-cmdk-hint">Press <strong>Ctrl+K</strong> to open · <strong>Esc</strong> to close</div>
        </div>
      </div>
    </t>

    <!-- FILTER BAR -->
    <div class="eagle-filter">
      <div class="eagle-preset-bar">
        <button t-on-click="()=>this.applyPreset('today')" t-attf-class="eagle-preset-btn #{state.active_preset=='today'?'active':''}">Today</button>
        <button t-on-click="()=>this.applyPreset('this_week')" t-attf-class="eagle-preset-btn #{state.active_preset=='this_week'?'active':''}">This Week</button>
        <button t-on-click="()=>this.applyPreset('this_month')" t-attf-class="eagle-preset-btn #{state.active_preset=='this_month'?'active':''}">This Month</button>
        <button t-on-click="()=>this.applyPreset('this_year')" t-attf-class="eagle-preset-btn #{state.active_preset=='this_year'?'active':''}">This Year</button>
        <button t-on-click="()=>this.applyPreset('all')" t-attf-class="eagle-preset-btn #{state.active_preset=='all'?'active':''}">All Time</button>
      </div>
      <div class="row g-2 align-items-end">
        <div class="col-6 col-md-auto">
          <label class="form-label mb-1 small text-muted">Month</label>
          <select class="form-select form-select-sm" t-on-change="onMonthChange">
            <t t-foreach="monthOptions" t-as="mo" t-key="mo.value"><option t-att-value="mo.value" t-att-selected="state.selected_month==mo.value"><t t-esc="mo.label"/></option></t>
          </select>
        </div>
        <div class="col-6 col-md-auto">
          <label class="form-label mb-1 small text-muted">Year</label>
          <select class="form-select form-select-sm" t-on-change="onYearChange">
            <t t-foreach="yearOptions" t-as="yr" t-key="yr"><option t-att-value="yr" t-att-selected="state.selected_year==yr.toString()"><t t-esc="yr"/></option></t>
          </select>
        </div>
        <div class="col-6 col-md-auto"><label class="form-label mb-1 small text-muted">From</label><input type="date" class="form-control form-control-sm" t-model="state.from_date" t-on-change="onDateChange"/></div>
        <div class="col-6 col-md-auto"><label class="form-label mb-1 small text-muted">To</label><input type="date" class="form-control form-control-sm" t-model="state.to_date" t-on-change="onDateChange"/></div>
        <div class="col-12 col-md">
          <label class="form-label mb-1 small text-muted">Partner Name</label>
          <input type="text" class="form-control form-control-sm" placeholder="Search by name..." t-model="state.partner_filter"/>
        </div>
        <div class="col-auto">
          <label class="form-label mb-1 small text-muted d-block">&#160;</label>
          <div class="form-check" title="Matching a company name also shows its individual contacts.">
            <input class="form-check-input" type="checkbox" id="operationsIncludeChildren" t-att-checked="state.includeChildContacts" t-on-change="toggleIncludeChildContacts"/>
            <label class="form-check-label small" for="operationsIncludeChildren">Include related contacts</label>
          </div>
        </div>
        <div class="col-12 col-md-auto">
          <label class="form-label mb-1 small text-muted">Partner ID</label>
          <div class="input-group input-group-sm">
            <select class="form-select form-select-sm" style="min-width:150px" t-on-change="(ev)=>{this.state.partner_id_filter=ev.target.value;}">
              <option value="">— All Partners —</option>
              <t t-foreach="state.partnerOptions" t-as="p" t-key="p.id"><option t-att-value="p.id" t-att-selected="state.partner_id_filter===p.id"><t t-esc="p.name"/> (#<t t-esc="p.id"/>)</option></t>
            </select>
            <t t-if="state.partner_id_filter"><button class="btn btn-outline-secondary btn-sm" t-on-click="()=>{this.state.partner_id_filter='';}">&#x2715;</button></t>
          </div>
        </div>
        <div class="col-12 col-md-auto">
          <label class="form-label mb-1 small text-muted">Status</label>
          <select class="form-select form-select-sm" t-on-change="(ev)=>{this.state.statusFilter=ev.target.value;}">
            <option value="">— All Statuses —</option>
            <option value="draft">Draft</option>
            <option value="sent">Sent</option>
            <option value="sale">Confirmed</option>
            <option value="purchase">Purchase</option>
            <option value="done">Done</option>
            <option value="cancel">Cancelled</option>
          </select>
        </div>
      </div>
    </div>

    <!-- MAIN TABLES -->
    <div class="eagle-two-col">
      <!-- Orders -->
      <div class="eagle-card">
        <div class="eagle-card-header">
          <h4 t-attf-class="eagle-card-title eagle-table-title-toggle #{state.tableSectionsOpen.orders ? '' : 'is-collapsed'}" role="button" tabindex="0" t-att-aria-expanded="state.tableSectionsOpen.orders" t-on-click="()=>this.toggleOperationsTable('orders')" t-on-keydown="(ev)=>this.onOperationsTableTitleKeydown(ev,'orders')"><i class="fa fa-file-text-o"/>Orders <span class="ebadge ebadge-blue ms-1"><t t-esc="filteredOrders.length"/></span><i t-attf-class="fa #{state.tableSectionsOpen.orders ? 'fa-chevron-up' : 'fa-chevron-down'} eagle-table-title-chevron ms-2"/></h4>
          <div class="d-flex gap-2"><button class="ebtn ebtn-sm ebtn-outline" t-on-click="exportOrders" title="Export CSV"><i class="fa fa-download"/></button><button class="ebtn ebtn-sm ebtn-primary" t-on-click="createOrder"><i class="fa fa-plus"/> New</button></div>
        </div>
        <div t-attf-class="eagle-table-wrap #{state.tableSectionsOpen.orders ? '' : 'eagle-table-hidden'}"><table class="eagle-table" data-eagle-managed-controls="1">
          <thead><tr>
            <th class="sortable" t-on-click="()=>this.sortOperationsTable('orders','name')">Order <i t-attf-class="fa #{state.tableSort.orders.key==='name' ? (state.tableSort.orders.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th>
            <th class="sortable" t-on-click="()=>this.sortOperationsTable('orders','partner')">Partner <i t-attf-class="fa #{state.tableSort.orders.key==='partner' ? (state.tableSort.orders.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th>
            <th t-if="showDateColumn" class="sortable" t-on-click="()=>this.sortOperationsTable('orders','date')">Date <i t-attf-class="fa #{state.tableSort.orders.key==='date' ? (state.tableSort.orders.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th>
            <th class="sortable" t-on-click="()=>this.sortOperationsTable('orders','status')">Status <i t-attf-class="fa #{state.tableSort.orders.key==='status' ? (state.tableSort.orders.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th>
            <th class="sortable" t-on-click="()=>this.sortOperationsTable('orders','invoice_status')">Invoice <i t-attf-class="fa #{state.tableSort.orders.key==='invoice_status' ? (state.tableSort.orders.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th>
            <th class="sortable text-end" t-on-click="()=>this.sortOperationsTable('orders','amount')">Amount <i t-attf-class="fa #{state.tableSort.orders.key==='amount' ? (state.tableSort.orders.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th>
          </tr></thead>
          <tbody>
            <t t-if="filteredOrders.length===0"><tr><td t-att-colspan="showDateColumn?6:5" class="text-center text-muted py-3">No orders found.</td></tr></t>
            <t t-foreach="sortedOrders" t-as="o" t-key="o.id"><tr>
              <td><a class="link" href="#" t-on-click.prevent="()=>this.openOrder(o.id)"><t t-esc="o.name"/></a></td>
              <td><a class="link" href="#" t-on-click.prevent="()=>this.openPartner(o.partner_id)"><t t-esc="o.partner"/></a></td>
              <td t-if="showDateColumn"><t t-esc="o.date"/></td>
              <td><span class="ebadge ebadge-green"><t t-esc="o.status"/></span></td>
              <td><span t-attf-class="ebadge #{o.invoice_status=='invoiced'?'ebadge-green':o.invoice_status=='to invoice'?'ebadge-yellow':'ebadge-gray'}"><t t-esc="o.invoice_status"/></span></td>
              <td class="text-end money"><t t-esc="formatAmount(o.amount)"/></td>
            </tr></t>
          </tbody>
          <tfoot><tr><td t-att-colspan="showDateColumn?5:4">Total (<t t-esc="filteredOrders.length"/>)</td><td class="text-end money fw-bold"><t t-esc="_sum(filteredOrders,'amount')"/></td></tr></tfoot>
        </table></div>
      </div>

      <!-- Purchase -->
      <div class="eagle-card">
        <div class="eagle-card-header">
          <h4 t-attf-class="eagle-card-title eagle-table-title-toggle #{state.tableSectionsOpen.purchases ? '' : 'is-collapsed'}" role="button" tabindex="0" t-att-aria-expanded="state.tableSectionsOpen.purchases" t-on-click="()=>this.toggleOperationsTable('purchases')" t-on-keydown="(ev)=>this.onOperationsTableTitleKeydown(ev,'purchases')"><i class="fa fa-shopping-bag"/>Purchase <span class="ebadge ebadge-purple ms-1"><t t-esc="filteredPurchases.length"/></span><i t-attf-class="fa #{state.tableSectionsOpen.purchases ? 'fa-chevron-up' : 'fa-chevron-down'} eagle-table-title-chevron ms-2"/></h4>
          <div class="d-flex gap-2"><button class="ebtn ebtn-sm ebtn-outline" t-on-click="exportPurchases" title="Export CSV"><i class="fa fa-download"/></button><button class="ebtn ebtn-sm ebtn-green" t-on-click="createPurchase"><i class="fa fa-plus"/> New</button></div>
        </div>
        <div t-attf-class="eagle-table-wrap #{state.tableSectionsOpen.purchases ? '' : 'eagle-table-hidden'}"><table class="eagle-table" data-eagle-managed-controls="1">
          <thead><tr>
            <th class="sortable" t-on-click="()=>this.sortOperationsTable('purchases','name')">Order <i t-attf-class="fa #{state.tableSort.purchases.key==='name' ? (state.tableSort.purchases.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th>
            <th class="sortable" t-on-click="()=>this.sortOperationsTable('purchases','partner')">Partner <i t-attf-class="fa #{state.tableSort.purchases.key==='partner' ? (state.tableSort.purchases.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th>
            <th t-if="showDateColumn" class="sortable" t-on-click="()=>this.sortOperationsTable('purchases','date')">Date <i t-attf-class="fa #{state.tableSort.purchases.key==='date' ? (state.tableSort.purchases.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th>
            <th class="sortable" t-on-click="()=>this.sortOperationsTable('purchases','status')">Status <i t-attf-class="fa #{state.tableSort.purchases.key==='status' ? (state.tableSort.purchases.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th>
            <th class="sortable" t-on-click="()=>this.sortOperationsTable('purchases','billing_status')">Billing <i t-attf-class="fa #{state.tableSort.purchases.key==='billing_status' ? (state.tableSort.purchases.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th>
            <th class="sortable text-end" t-on-click="()=>this.sortOperationsTable('purchases','amount')">Amount <i t-attf-class="fa #{state.tableSort.purchases.key==='amount' ? (state.tableSort.purchases.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th>
          </tr></thead>
          <tbody>
            <t t-if="filteredPurchases.length===0"><tr><td t-att-colspan="showDateColumn?6:5" class="text-center text-muted py-3">No purchases found.</td></tr></t>
            <t t-foreach="sortedPurchases" t-as="p" t-key="p.id"><tr>
              <td><a class="link" href="#" t-on-click.prevent="()=>this.openPurchase(p.id)"><t t-esc="p.name"/></a></td>
              <td><a class="link" href="#" t-on-click.prevent="()=>this.openPartner(p.partner_id)"><t t-esc="p.partner"/></a></td>
              <td t-if="showDateColumn"><t t-esc="p.date"/></td>
              <td><span class="ebadge ebadge-blue"><t t-esc="p.status"/></span></td>
              <td><span t-attf-class="ebadge #{p.billing_status=='invoiced'?'ebadge-green':p.billing_status=='to invoice'?'ebadge-yellow':'ebadge-gray'}"><t t-esc="p.billing_status"/></span></td>
              <td class="text-end money"><t t-esc="formatAmount(p.amount)"/></td>
            </tr></t>
          </tbody>
          <tfoot><tr><td t-att-colspan="showDateColumn?5:4">Total (<t t-esc="filteredPurchases.length"/>)</td><td class="text-end money fw-bold"><t t-esc="_sum(filteredPurchases,'amount')"/></td></tr></tfoot>
        </table></div>
      </div>

      <!-- Quotations -->
      <div class="eagle-card">
        <div class="eagle-card-header"><h4 t-attf-class="eagle-card-title eagle-table-title-toggle #{state.tableSectionsOpen.quotations ? '' : 'is-collapsed'}" role="button" tabindex="0" t-att-aria-expanded="state.tableSectionsOpen.quotations" t-on-click="()=>this.toggleOperationsTable('quotations')" t-on-keydown="(ev)=>this.onOperationsTableTitleKeydown(ev,'quotations')"><i class="fa fa-file-o"/>Quotations <span class="ebadge ebadge-gray ms-1"><t t-esc="filteredQuotations.length"/></span><i t-attf-class="fa #{state.tableSectionsOpen.quotations ? 'fa-chevron-up' : 'fa-chevron-down'} eagle-table-title-chevron ms-2"/></h4><button class="ebtn ebtn-sm ebtn-outline" t-on-click="exportQuotes" title="Export CSV"><i class="fa fa-download"/></button></div>
        <div t-attf-class="eagle-table-wrap #{state.tableSectionsOpen.quotations ? '' : 'eagle-table-hidden'}"><table class="eagle-table" data-eagle-managed-controls="1">
          <thead><tr><th class="sortable" t-on-click="()=>this.sortOperationsTable('quotations','name')">Quotation <i t-attf-class="fa #{state.tableSort.quotations.key==='name' ? (state.tableSort.quotations.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable" t-on-click="()=>this.sortOperationsTable('quotations','partner')">Partner <i t-attf-class="fa #{state.tableSort.quotations.key==='partner' ? (state.tableSort.quotations.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><t t-if="showDateColumn"><th class="sortable" t-on-click="()=>this.sortOperationsTable('quotations','date')">Date <i t-attf-class="fa #{state.tableSort.quotations.key==='date' ? (state.tableSort.quotations.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th></t><th class="sortable" t-on-click="()=>this.sortOperationsTable('quotations','status')">Status <i t-attf-class="fa #{state.tableSort.quotations.key==='status' ? (state.tableSort.quotations.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable text-end" t-on-click="()=>this.sortOperationsTable('quotations','amount')">Amount <i t-attf-class="fa #{state.tableSort.quotations.key==='amount' ? (state.tableSort.quotations.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th></tr></thead>
          <tbody>
            <t t-if="filteredQuotations.length===0"><tr><td t-att-colspan="showDateColumn?5:4" class="text-center text-muted py-3">No quotations found.</td></tr></t>
            <t t-foreach="sortedQuotations" t-as="q" t-key="q.id"><tr>
              <td><a class="link" href="#" t-on-click.prevent="()=>this.openOrder(q.id)"><t t-esc="q.name"/></a></td>
              <td><a class="link" href="#" t-on-click.prevent="()=>this.openPartner(q.partner_id)"><t t-esc="q.partner"/></a></td>
              <td t-if="showDateColumn"><t t-esc="q.date"/></td>
              <td><span class="ebadge ebadge-gray"><t t-esc="q.status"/></span></td>
              <td class="text-end money"><t t-esc="formatAmount(q.amount)"/></td>
            </tr></t>
          </tbody>
          <tfoot><tr><td t-att-colspan="showDateColumn?4:3">Total (<t t-esc="filteredQuotations.length"/>)</td><td class="text-end money fw-bold"><t t-esc="_sum(filteredQuotations,'amount')"/></td></tr></tfoot>
        </table></div>
      </div>

      <!-- RFQ -->
      <div class="eagle-card">
        <div class="eagle-card-header"><h4 t-attf-class="eagle-card-title eagle-table-title-toggle #{state.tableSectionsOpen.rfq ? '' : 'is-collapsed'}" role="button" tabindex="0" t-att-aria-expanded="state.tableSectionsOpen.rfq" t-on-click="()=>this.toggleOperationsTable('rfq')" t-on-keydown="(ev)=>this.onOperationsTableTitleKeydown(ev,'rfq')"><i class="fa fa-envelope-o"/>RFQ <span class="ebadge ebadge-gray ms-1"><t t-esc="filteredRfq.length"/></span><i t-attf-class="fa #{state.tableSectionsOpen.rfq ? 'fa-chevron-up' : 'fa-chevron-down'} eagle-table-title-chevron ms-2"/></h4><button class="ebtn ebtn-sm ebtn-outline" t-on-click="exportRfq" title="Export CSV"><i class="fa fa-download"/></button></div>
        <div t-attf-class="eagle-table-wrap #{state.tableSectionsOpen.rfq ? '' : 'eagle-table-hidden'}"><table class="eagle-table" data-eagle-managed-controls="1">
          <thead><tr><th class="sortable" t-on-click="()=>this.sortOperationsTable('rfq','name')">Order <i t-attf-class="fa #{state.tableSort.rfq.key==='name' ? (state.tableSort.rfq.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable" t-on-click="()=>this.sortOperationsTable('rfq','partner')">Partner <i t-attf-class="fa #{state.tableSort.rfq.key==='partner' ? (state.tableSort.rfq.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><t t-if="showDateColumn"><th class="sortable" t-on-click="()=>this.sortOperationsTable('rfq','date')">Date <i t-attf-class="fa #{state.tableSort.rfq.key==='date' ? (state.tableSort.rfq.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th></t><th class="sortable" t-on-click="()=>this.sortOperationsTable('rfq','status')">Status <i t-attf-class="fa #{state.tableSort.rfq.key==='status' ? (state.tableSort.rfq.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable text-end" t-on-click="()=>this.sortOperationsTable('rfq','amount')">Amount <i t-attf-class="fa #{state.tableSort.rfq.key==='amount' ? (state.tableSort.rfq.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th></tr></thead>
          <tbody>
            <t t-if="filteredRfq.length===0"><tr><td t-att-colspan="showDateColumn?5:4" class="text-center text-muted py-3">No RFQs found.</td></tr></t>
            <t t-foreach="sortedRfq" t-as="r" t-key="r.id"><tr>
              <td><a class="link" href="#" t-on-click.prevent="()=>this.openPurchase(r.id)"><t t-esc="r.name"/></a></td>
              <td><a class="link" href="#" t-on-click.prevent="()=>this.openPartner(r.partner_id)"><t t-esc="r.partner"/></a></td>
              <td t-if="showDateColumn"><t t-esc="r.date"/></td>
              <td><span class="ebadge ebadge-gray"><t t-esc="r.status"/></span></td>
              <td class="text-end money"><t t-esc="formatAmount(r.amount)"/></td>
            </tr></t>
          </tbody>
          <tfoot><tr><td t-att-colspan="showDateColumn?4:3">Total (<t t-esc="filteredRfq.length"/>)</td><td class="text-end money fw-bold"><t t-esc="_sum(filteredRfq,'amount')"/></td></tr></tfoot>
        </table></div>
      </div>
    </div>

    <!-- TRANSACTIONS -->
    <div class="eagle-card">
      <div class="eagle-card-header">
        <h4 t-attf-class="eagle-card-title eagle-table-title-toggle #{state.tableSectionsOpen.transactions ? '' : 'is-collapsed'}" role="button" tabindex="0" t-att-aria-expanded="state.tableSectionsOpen.transactions" t-on-click="()=>this.toggleOperationsTable('transactions')" t-on-keydown="(ev)=>this.onOperationsTableTitleKeydown(ev,'transactions')"><i class="fa fa-exchange"/>Transactions <span class="ebadge ebadge-blue ms-1"><t t-esc="filteredTransactions.length"/></span><i t-attf-class="fa #{state.tableSectionsOpen.transactions ? 'fa-chevron-up' : 'fa-chevron-down'} eagle-table-title-chevron ms-2"/></h4>
        <div class="d-flex gap-2 flex-wrap">
          <button class="ebtn ebtn-sm ebtn-outline" t-on-click="exportTx" title="Export CSV"><i class="fa fa-download"/></button>
          <button class="ebtn ebtn-sm ebtn-blue" t-on-click="()=>this.createPayment('inbound')"><i class="fa fa-arrow-down"/> Receive</button>
          <button class="ebtn ebtn-sm ebtn-red" t-on-click="()=>this.createPayment('outbound')"><i class="fa fa-arrow-up"/> Send</button>
        </div>
      </div>
      <div t-attf-class="eagle-table-wrap #{state.tableSectionsOpen.transactions ? '' : 'eagle-table-hidden'}"><table class="eagle-table" data-eagle-managed-controls="1">
        <thead><tr>
          <th class="sortable" t-on-click="()=>this.sortOperationsTable('transactions','name')">Reference <i t-attf-class="fa #{state.tableSort.transactions.key==='name' ? (state.tableSort.transactions.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><t t-if="showDateColumn"><th class="sortable" t-on-click="()=>this.sortOperationsTable('transactions','date')">Date <i t-attf-class="fa #{state.tableSort.transactions.key==='date' ? (state.tableSort.transactions.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th></t><th class="sortable" t-on-click="()=>this.sortOperationsTable('transactions','partner')">Partner <i t-attf-class="fa #{state.tableSort.transactions.key==='partner' ? (state.tableSort.transactions.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable" t-on-click="()=>this.sortOperationsTable('transactions','ledger')">Ledger <i t-attf-class="fa #{state.tableSort.transactions.key==='ledger' ? (state.tableSort.transactions.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable text-end" t-on-click="()=>this.sortOperationsTable('transactions','received')">Received <i t-attf-class="fa #{state.tableSort.transactions.key==='received' ? (state.tableSort.transactions.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable text-end" t-on-click="()=>this.sortOperationsTable('transactions','paid')">Paid <i t-attf-class="fa #{state.tableSort.transactions.key==='paid' ? (state.tableSort.transactions.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable" t-on-click="()=>this.sortOperationsTable('transactions','state')">Status <i t-attf-class="fa #{state.tableSort.transactions.key==='state' ? (state.tableSort.transactions.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th>
        </tr></thead>
        <tbody>
          <t t-if="filteredTransactions.length===0"><tr><td t-att-colspan="showDateColumn?7:6" class="text-center text-muted py-3">No transactions found.</td></tr></t>
          <t t-foreach="sortedTransactions" t-as="tx" t-key="tx.id"><tr>
            <td><a class="link" href="#" t-on-click.prevent="()=>this.openTransaction(tx.id)"><t t-esc="tx.name"/></a></td>
            <td t-if="showDateColumn"><t t-esc="tx.date"/></td>
            <td><a class="link" href="#" t-on-click.prevent="()=>this.openPartner(tx.partner_id)"><t t-esc="tx.partner"/></a></td>
            <td><t t-esc="tx.ledger"/></td>
            <td class="text-end money-in"><t t-esc="formatAmount(tx.received)"/></td>
            <td class="text-end money-out"><t t-esc="formatAmount(tx.paid)"/></td>
            <td>
              <span t-attf-class="ebadge #{(tx.state=='paid'||tx.state=='in_process')?'ebadge-green':tx.state=='draft'?'ebadge-gray':(tx.state=='canceled'||tx.state=='rejected')?'ebadge-red':'ebadge-yellow'}"><t t-esc="tx.state"/></span>
              <button t-if="tx.state=='draft'" class="ebtn ebtn-sm ebtn-green ms-2" t-att-disabled="state.validatingPaymentId===tx.id" t-on-click="()=>this.validatePayment(tx.id)" title="Post / Validate payment"><i class="fa fa-check"/> Validate</button>
            </td>
          </tr></t>
        </tbody>
        <tfoot><tr><td t-att-colspan="showDateColumn?4:3">Total (<t t-esc="filteredTransactions.length"/>)</td><td class="text-end money-in fw-bold"><t t-esc="txTotalReceived"/></td><td class="text-end money-out fw-bold"><t t-esc="txTotalPaid"/></td><td/></tr></tfoot>
      </table></div>
    </div>

    <!-- WAREHOUSE OPERATIONS -->
    <div class="eagle-two-col">
      <div class="eagle-card">
        <div class="eagle-card-header"><h4 t-attf-class="eagle-card-title eagle-table-title-toggle #{state.tableSectionsOpen.deliveries ? '' : 'is-collapsed'}" role="button" tabindex="0" t-att-aria-expanded="state.tableSectionsOpen.deliveries" t-on-click="()=>this.toggleOperationsTable('deliveries')" t-on-keydown="(ev)=>this.onOperationsTableTitleKeydown(ev,'deliveries')"><i class="fa fa-truck"/>Delivery Orders <span class="ebadge ebadge-gray ms-1"><t t-esc="filteredDeliveries.length"/></span><i t-attf-class="fa #{state.tableSectionsOpen.deliveries ? 'fa-chevron-up' : 'fa-chevron-down'} eagle-table-title-chevron ms-2"/></h4><button class="ebtn ebtn-sm ebtn-outline" t-on-click="exportDeliveries" title="Export CSV"><i class="fa fa-download"/></button></div>
        <div t-attf-class="eagle-table-wrap #{state.tableSectionsOpen.deliveries ? '' : 'eagle-table-hidden'}"><table class="eagle-table" data-eagle-managed-controls="1">
          <thead><tr>
            <t t-foreach="deliveryColumns" t-as="col" t-key="col.key">
              <th class="eagle-delivery-column-header" t-att-data-column="col.key"
                  t-on-dragover.prevent="onDeliveryColumnDragOver"
                  t-on-drop="(ev)=>this.onDeliveryColumnDrop(ev,col.key)">
                <span class="eagle-column-drag-handle" draggable="true"
                      t-on-dragstart="(ev)=>this.onDeliveryColumnDragStart(ev,col.key)"
                      t-on-dragend="onDeliveryColumnDragEnd"
                      title="Drag to reorder column" aria-label="Drag to reorder column"><i class="fa fa-bars"/></span>
                <span class="eagle-sort-heading" t-on-click.stop="()=>this.sortOperationsTable('deliveries',col.sortKey)">
                  <t t-esc="col.label"/>
                  <i t-attf-class="fa #{state.tableSort.deliveries.key===col.sortKey ? (state.tableSort.deliveries.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/>
                </span>
              </th>
            </t>
          </tr></thead>
          <tbody>
            <t t-if="filteredDeliveries.length===0"><tr><td t-att-colspan="deliveryColumns.length" class="text-center text-muted py-3">No delivery orders found.</td></tr></t>
            <t t-foreach="sortedDeliveries" t-as="d" t-key="d.id"><tr>
              <t t-foreach="deliveryColumns" t-as="col" t-key="col.key"><td>
                <t t-if="col.key === 'name'">
                  <a class="link" href="#" t-on-click.prevent="()=>this.openPicking(d.id)"><t t-esc="d.name"/></a>
                </t>
                <t t-elif="col.key === 'partner'">
                  <a class="link" href="#" t-on-click.prevent="()=>this.openPartner(d.partner_id)"><t t-esc="d.partner"/></a>
                </t>
                <t t-elif="col.key === 'partner_mobile'">
                  <a t-if="d.partner_mobile" class="link" t-att-href="'tel:' + d.partner_mobile"><t t-esc="d.partner_mobile"/></a>
                  <span t-else="">—</span>
                </t>
                <t t-elif="col.key === 'creation_date'"><t t-esc="d.creation_date"/></t>
                <t t-elif="col.key === 'date_done'"><t t-esc="d.date_done"/></t>
                <t t-elif="col.key === 'carrier'"><t t-esc="d.carrier || '—'"/></t>
                <t t-elif="col.key === 'tracking_reference'">
                  <t t-if="d.tracking_reference">
                    <t t-if="d.tracking_url">
                      <a class="link" t-att-href="d.tracking_url" target="_blank" rel="noopener noreferrer" title="Open shipment tracking page in a new tab">
                        <t t-esc="d.tracking_reference"/> <i class="fa fa-external-link ms-1"/>
                      </a>
                    </t>
                    <t t-else=""><span><t t-esc="d.tracking_reference"/></span></t>
                  </t>
                  <t t-else="">
                    <input type="text" class="form-control form-control-sm eagle-tracking-input"
                           placeholder="Enter tracking reference"
                           t-on-keydown="(ev)=>this.onTrackingReferenceKeydown(d, ev)"
                           t-on-blur="(ev)=>this.saveTrackingReference(d, ev)"/>
                  </t>
                </t>
                <t t-elif="col.key === 'state'">
                  <t t-if="['done', 'cancel'].indexOf(d.state) === -1">
                    <button type="button"
                            t-attf-class="ebtn ebtn-sm #{d.late?'ebtn-red':'ebtn-outline'}"
                            t-att-disabled="state.validatingPickingId===d.id"
                            t-on-click="(ev)=>this.validatePicking(d.id, ev)"
                            title="Validate / change delivery status">
                      <t t-esc="deliveryStatusLabel(d.state)"/>
                    </button>
                  </t>
                  <t t-else="">
                    <span t-attf-class="ebadge #{d.state=='done'?'ebadge-green':'ebadge-red'}"><t t-esc="deliveryStatusLabel(d.state)"/></span>
                  </t>
                </t>
              </td></t>
            </tr></t>
          </tbody>
          <tfoot><tr><td colspan="7">Total (<t t-esc="filteredDeliveries.length"/>)</td><td/></tr></tfoot>
        </table></div>
      </div>

      <div class="eagle-card">
        <div class="eagle-card-header"><h4 t-attf-class="eagle-card-title eagle-table-title-toggle #{state.tableSectionsOpen.receipts ? '' : 'is-collapsed'}" role="button" tabindex="0" t-att-aria-expanded="state.tableSectionsOpen.receipts" t-on-click="()=>this.toggleOperationsTable('receipts')" t-on-keydown="(ev)=>this.onOperationsTableTitleKeydown(ev,'receipts')"><i class="fa fa-inbox"/>Receiving Orders <span class="ebadge ebadge-gray ms-1"><t t-esc="filteredReceipts.length"/></span><i t-attf-class="fa #{state.tableSectionsOpen.receipts ? 'fa-chevron-up' : 'fa-chevron-down'} eagle-table-title-chevron ms-2"/></h4><button class="ebtn ebtn-sm ebtn-outline" t-on-click="exportReceipts" title="Export CSV"><i class="fa fa-download"/></button></div>
        <div t-attf-class="eagle-table-wrap #{state.tableSectionsOpen.receipts ? '' : 'eagle-table-hidden'}"><table class="eagle-table" data-eagle-managed-controls="1">
          <thead><tr><th class="sortable" t-on-click="()=>this.sortOperationsTable('receipts','name')">Reference <i t-attf-class="fa #{state.tableSort.receipts.key==='name' ? (state.tableSort.receipts.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable" t-on-click="()=>this.sortOperationsTable('receipts','partner')">Vendor <i t-attf-class="fa #{state.tableSort.receipts.key==='partner' ? (state.tableSort.receipts.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable" t-on-click="()=>this.sortOperationsTable('receipts','creation_date')">Creation Date <i t-attf-class="fa #{state.tableSort.receipts.key==='creation_date' ? (state.tableSort.receipts.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable" t-on-click="()=>this.sortOperationsTable('receipts','date_done')">Complete Date <i t-attf-class="fa #{state.tableSort.receipts.key==='date_done' ? (state.tableSort.receipts.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable" t-on-click="()=>this.sortOperationsTable('receipts','state')">Status <i t-attf-class="fa #{state.tableSort.receipts.key==='state' ? (state.tableSort.receipts.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th></tr></thead>
          <tbody>
            <t t-if="filteredReceipts.length===0"><tr><td colspan="5" class="text-center text-muted py-3">No receiving orders found.</td></tr></t>
            <t t-foreach="sortedReceipts" t-as="r" t-key="r.id"><tr>
              <td><a class="link" href="#" t-on-click.prevent="()=>this.openPicking(r.id)"><t t-esc="r.name"/></a></td>
              <td><a class="link" href="#" t-on-click.prevent="()=>this.openPartner(r.partner_id)"><t t-esc="r.partner"/></a></td>
              <td><t t-esc="r.creation_date"/></td><td><t t-esc="r.date_done"/></td>
              <td><span t-attf-class="ebadge #{r.state=='done'?'ebadge-green':r.late?'ebadge-red':'ebadge-yellow'}"><t t-esc="r.state"/></span></td>
            </tr></t>
          </tbody>
          <tfoot><tr><td colspan="4">Total (<t t-esc="filteredReceipts.length"/>)</td><td/></tr></tfoot>
        </table></div>
      </div>
    </div>

    <!-- INTERNAL STOCK TRANSFERS -->
    <div class="eagle-two-col">
      <div class="eagle-card">
        <div class="eagle-card-header">
          <h4 t-attf-class="eagle-card-title eagle-table-title-toggle #{state.tableSectionsOpen.internal ? '' : 'is-collapsed'}" role="button" tabindex="0" t-att-aria-expanded="state.tableSectionsOpen.internal" t-on-click="()=>this.toggleOperationsTable('internal')" t-on-keydown="(ev)=>this.onOperationsTableTitleKeydown(ev,'internal')"><i class="fa fa-random"/>Internal Stock Transfer <span class="ebadge ebadge-gray ms-1"><t t-esc="filteredInternal.length"/></span><i t-attf-class="fa #{state.tableSectionsOpen.internal ? 'fa-chevron-up' : 'fa-chevron-down'} eagle-table-title-chevron ms-2"/></h4>
          <button class="ebtn ebtn-sm ebtn-outline" t-on-click="exportInternal" title="Export CSV"><i class="fa fa-download"/></button>
        </div>
        <div t-attf-class="eagle-table-wrap #{state.tableSectionsOpen.internal ? '' : 'eagle-table-hidden'}"><table class="eagle-table" data-eagle-managed-controls="1">
          <thead><tr><th class="sortable" t-on-click="()=>this.sortOperationsTable('internal','name')">Reference <i t-attf-class="fa #{state.tableSort.internal.key==='name' ? (state.tableSort.internal.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable" t-on-click="()=>this.sortOperationsTable('internal','from_location')">From <i t-attf-class="fa #{state.tableSort.internal.key==='from_location' ? (state.tableSort.internal.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable" t-on-click="()=>this.sortOperationsTable('internal','to_location')">To <i t-attf-class="fa #{state.tableSort.internal.key==='to_location' ? (state.tableSort.internal.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable" t-on-click="()=>this.sortOperationsTable('internal','creation_datetime')">Creation Date <i t-attf-class="fa #{state.tableSort.internal.key==='creation_datetime' ? (state.tableSort.internal.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable" t-on-click="()=>this.sortOperationsTable('internal','scheduled_datetime')">Scheduled Date <i t-attf-class="fa #{state.tableSort.internal.key==='scheduled_datetime' ? (state.tableSort.internal.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable" t-on-click="()=>this.sortOperationsTable('internal','state')">Status <i t-attf-class="fa #{state.tableSort.internal.key==='state' ? (state.tableSort.internal.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th><th class="sortable" t-on-click="()=>this.sortOperationsTable('internal','responsible')">Responsible <i t-attf-class="fa #{state.tableSort.internal.key==='responsible' ? (state.tableSort.internal.direction==='asc' ? 'fa-sort-asc' : 'fa-sort-desc') : 'fa-sort'} ms-1"/></th></tr></thead>
          <tbody>
            <t t-if="filteredInternal.length===0"><tr><td colspan="7" class="text-center text-muted py-3">No internal stock transfers found.</td></tr></t>
            <t t-foreach="sortedInternal" t-as="i" t-key="i.id"><tr>
              <td><a class="link" href="#" t-on-click.prevent="()=>this.openPicking(i.id)"><t t-esc="i.name"/></a></td>
              <td>
                <t t-if="i.from_location_id"><a class="link" href="#" t-on-click.prevent="()=>this.openLocation(i.from_location_id)"><t t-esc="i.from_location"/></a></t>
                <t t-else=""><t t-esc="i.from_location || '—'"/></t>
              </td>
              <td>
                <t t-if="i.to_location_id"><a class="link" href="#" t-on-click.prevent="()=>this.openLocation(i.to_location_id)"><t t-esc="i.to_location"/></a></t>
                <t t-else=""><t t-esc="i.to_location || '—'"/></t>
              </td>
              <td><t t-esc="i.creation_datetime || i.creation_date"/></td>
              <td><t t-esc="i.scheduled_datetime || i.scheduled_date"/></td>
              <td>
                <t t-if="['done', 'cancel'].indexOf(i.state) === -1">
                  <button type="button" t-attf-class="ebtn ebtn-sm #{i.late?'ebtn-red':'ebtn-outline'}"
                          t-att-disabled="state.validatingPickingId===i.id"
                          t-on-click="(ev)=>this.validatePicking(i.id, ev)"
                          title="Validate / change internal transfer status"><t t-esc="deliveryStatusLabel(i.state)"/></button>
                </t>
                <t t-else=""><span t-attf-class="ebadge #{i.state=='done'?'ebadge-green':'ebadge-red'}"><t t-esc="deliveryStatusLabel(i.state)"/></span></t>
              </td>
              <td>
                <t t-if="i.responsible_id"><a class="link" href="#" t-on-click.prevent="()=>this.openUser(i.responsible_id)"><t t-esc="i.responsible"/></a></t>
                <t t-else=""><t t-esc="i.responsible || '—'"/></t>
              </td>
            </tr></t>
          </tbody>
          <tfoot><tr><td colspan="7">Total (<t t-esc="filteredInternal.length"/>)</td></tr></tfoot>
        </table></div>
      </div>
    </div>

    <!-- Floating quick actions: Quick Internal Transfer sits beside Quick Sale. -->
    <button class="eagle-fab eagle-fab-internal" t-on-click="openQuickInternalTransfer" title="Quick Internal Transfer" aria-label="Quick Internal Transfer">
      <i class="fa fa-random"/>
    </button>
    <button class="eagle-fab" t-on-click="openQuickSale" title="Quick Sale">
      <i class="fa fa-plus"/>
    </button>

    <!-- TEAM NOTES -->
    <div class="eagle-card">
      <div class="eagle-card-header">
        <h4 class="eagle-card-title"><i class="fa fa-sticky-note-o"/>Team Notes</h4>
        <div class="d-flex align-items-center gap-2">
          <t t-if="state.notesSaved"><span class="eagle-notes-saved"><i class="fa fa-check"/> Saved!</span></t>
          <button class="ebtn ebtn-sm ebtn-primary" t-on-click="saveNotes"><i class="fa fa-save me-1"/>Save Notes</button>
        </div>
      </div>
      <div class="eagle-card-inner">
        <textarea class="eagle-notes-ta" placeholder="Leave shift notes, goals, or alerts for the team... use @Name to notify someone" t-model="state.teamNotes"/>
        <t t-if="state.notesMentioned and state.notesMentioned.length"><p class="text-muted small mt-2 mb-0"><i class="fa fa-bell-o me-1"/>Notified: <t t-esc="state.notesMentioned.join(', ')"/></p></t>
      </div>
    </div>

  </div>
</div>
</t>
</templates>
